<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300" 
        x:Class="okno.MainWindow"
        Title=":3c"
        Width="400"
        Height="450"
        WindowStartupLocation="CenterScreen">
    
    <TextBlock FontSize="32" FontWeight="Bold" Text="Mala ultro adsunt.
    Misfortune comes uninvited.
    It hungers for blood craving eternal darkness.
    My time to repent is over.
    I will take up arms again.
    Step out of shadow and teach them true Darkness."/>
    
</Window>
